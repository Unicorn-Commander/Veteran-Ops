# Veteran-Ops — copy to .env and fill in. NEVER commit the real .env.
# docker-compose.yml reads this file (env_file: .env) for the backend service.

# ── Database ─────────────────────────────────────────────────────────────────
# The app connects as the non-superuser `valor_app` role on purpose: row-level
# security is skipped entirely for superusers and BYPASSRLS roles.
POSTGRES_PASSWORD=change_me
APP_DB_PASSWORD=change_me_valor_app_pw

# ── Auth ─────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate one, do not invent one by hand:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_a_long_random_string_at_least_32_chars

# Open registration is the dev default. Set false for a public instance — the
# first account still bootstraps so an operator can create their own login.
ALLOW_REGISTRATION=true

# ── LLM gateway ──────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint (LiteLLM, vLLM, Ollama, llama.cpp server, …).
# There is no default worth shipping — point this at YOUR gateway.
LLM_BASE_URL=http://host.docker.internal:4000/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b
# Optional larger model for agent reasoning; falls back to LLM_MODEL when unset.
REASONING_MODEL=

# Optional embeddings endpoint. Leave blank to run without semantic search.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=bge-m3

# ── Web ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5174

# ── Optional: MCP service token ──────────────────────────────────────────────
# Only needed if you run the MCP server and want it to authenticate to the API.
MCP_SERVICE_TOKEN=
