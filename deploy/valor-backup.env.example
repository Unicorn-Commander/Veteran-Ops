# Copy to ~/.config/valor-ops/backup.env, then chmod 600. Never commit the
# populated file. Remote upload is disabled when VALOR_BACKUP_REMOTE_URI is
# unset; verified local backups continue to work.

# VALOR_BACKUP_REMOTE_URI=s3://replace-with-bucket/valor-ops-backups

# S3-compatible providers only; leave unset for AWS itself.
# VALOR_BACKUP_S3_ENDPOINT=https://replace-with-provider-endpoint

# Choose one standard AWS credential-chain method:
# export AWS_PROFILE=valor-ops-backup
# export AWS_ACCESS_KEY_ID=replace-at-deploy
# export AWS_SECRET_ACCESS_KEY=replace-at-deploy
# export AWS_DEFAULT_REGION=replace-at-deploy

# Environment encryption is optional until explicitly required. Once the age
# recipient is provisioned, fail closed if it cannot be used.
# VALOR_BACKUP_AGE_RECIPIENT_FILE=${HOME}/.config/valor-ops/backup-age-recipient.txt
# VALOR_BACKUP_REQUIRE_ENV=true
