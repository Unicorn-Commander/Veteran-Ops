# For the DEPLOYMENT compose files in this directory (docker-compose.*.yml),
# whose `env_file: .env` resolves here. For the local dev stack driven by the
# repo-root docker-compose.yml, use the repo-root .env.example instead.
# Copy to .env and fill for self-host. Never commit real values.
POSTGRES_PASSWORD=change_me
APP_DB_PASSWORD=change_me
JWT_SECRET=generate_a_long_random_string_at_least_32_chars
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b
REASONING_MODEL=qwen3.6-35b-64k
CORS_ORIGINS=http://localhost:5174
